---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Card from '../components/Card.astro';
import { getPublishedArticles, formatDate } from '../lib/content';

interface Props {
  entry: CollectionEntry<'resources'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allArticles = await getPublishedArticles();
const relatedArticles = allArticles.filter((article) =>
  entry.data.relatedArticles?.includes(article.data.slug)
);

const breadcrumbs = [
  { text: 'Home', href: '/' },
  { text: 'Risorse', href: '/risorsa/' },
  { text: entry.data.title },
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  breadcrumbs={breadcrumbs}
  schemaType="WebPage"
>
  <article class="resource container">
    <header class="resource-header">
      <Breadcrumbs items={breadcrumbs} />
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
    </header>

    <div class="prose">
      <Content />
    </div>

    {relatedArticles.length > 0 && (
      <section class="related-posts">
        <h2>Articoli collegati</h2>
        <div class="grid">
          {relatedArticles.map((article) => (
            <Card
              title={article.data.title}
              description={article.data.description}
              href={`/blog/${article.data.slug}/`}
              meta={formatDate(article.data.publishDate)}
              image={article.data.ogImage}
            />
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
