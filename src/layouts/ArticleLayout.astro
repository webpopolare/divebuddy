---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import KeyTakeaways from '../components/KeyTakeaways.astro';
import SeriesNavigation from '../components/SeriesNavigation.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import ShareLinks from '../components/ShareLinks.astro';
import NewsletterCTA from '../components/NewsletterCTA.astro';
import Comments from '../components/Comments.astro';
import { getCollection } from 'astro:content';
import { isPublishedArticle, readingTime } from '../lib/content';

interface Props {
  entry: CollectionEntry<'articles'>;
  related: CollectionEntry<'articles'>[];
}

const { entry, related } = Astro.props;

const { Content, headings } = await entry.render();

const hubs = await getCollection('hubs');
const hub = hubs.find((item) => item.data.slug === entry.data.hub);

const hubTitle = hub?.data.title ?? 'Hub';
const hubHref = hub ? `/hub/${hub.data.slug}/` : '/hub/';

const seriesArticles = entry.data.series
  ? (await getCollection('articles'))
      .filter(
        (article) =>
          article.data.series === entry.data.series &&
          isPublishedArticle(article)
      )
      .sort(
        (a, b) =>
          a.data.publishDate.valueOf() - b.data.publishDate.valueOf()
      )
  : [];

const currentIndex = seriesArticles.findIndex(
  (article) => article.data.slug === entry.data.slug
);

const prev = currentIndex > 0 ? seriesArticles[currentIndex - 1] : null;
const next =
  currentIndex >= 0 && currentIndex < seriesArticles.length - 1
    ? seriesArticles[currentIndex + 1]
    : null;

const seriesEntry = entry.data.series
  ? (await getCollection('series')).find(
      (item) => item.data.slug === entry.data.series
    )
  : null;

const shareUrl = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4321').href;

const breadcrumbs = [
  { text: 'Home', href: '/' },
  { text: 'Blog', href: '/blog/' },
  { text: hubTitle, href: hubHref },
  { text: entry.data.title },
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.ogImage}
  type="article"
  publishedTime={entry.data.publishDate.toISOString()}
  modifiedTime={(entry.data.updatedDate ?? entry.data.publishDate).toISOString()}
  author={entry.data.author}
  breadcrumbs={breadcrumbs}
  schemaType="BlogPosting"
>
  <article class="article container">
    <header class="article-header">
      <Breadcrumbs items={breadcrumbs} />
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>

      <ArticleMeta
        entry={entry}
        hubTitle={hubTitle}
        hubHref={hubHref}
        readingTime={readingTime(entry)}
      />
    </header>

    <div class="article-grid">
      {entry.data.showToc && (
        <aside class="article-aside">
          <TableOfContents headings={headings as any[]} />
        </aside>
      )}

      <div class="article-body">
        {entry.data.showKeyTakeaways && (
          <KeyTakeaways
            description={entry.data.description}
            cta={entry.data.cta}
          />
        )}

        <div class="prose">
          <Content />
        </div>

        {entry.data.cta && (
          <aside class="final-cta">
            <p>{entry.data.cta}</p>
          </aside>
        )}

        <ShareLinks url={shareUrl} title={entry.data.title} />

        {seriesEntry && (
          <SeriesNavigation
            seriesTitle={seriesEntry.data.title}
            seriesHref={`/serie/${seriesEntry.data.slug}/`}
            prev={prev}
            next={next}
          />
        )}

        <RelatedPosts articles={related} />

        {entry.data.showNewsletter && <NewsletterCTA />}

        {entry.data.showComments && <Comments />}
      </div>
    </div>
  </article>
</BaseLayout>