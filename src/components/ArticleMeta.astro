---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/content';

interface Props {
  entry: CollectionEntry<'articles'>;
  hubTitle: string;
  hubHref: string;
  readingTime: number;
}

const { entry, hubTitle, hubHref, readingTime } = Astro.props;
---

<div class="article-meta">
  <time datetime={entry.data.publishDate.toISOString()}>
    {formatDate(entry.data.publishDate)}
  </time>

  {entry.data.updatedDate && (
    <span>
      · aggiornato il {formatDate(entry.data.updatedDate)}
    </span>
  )}

  <span>· {readingTime} min di lettura</span>

  <a href={hubHref} class="meta-hub">{hubTitle}</a>

  {entry.data.tags && entry.data.tags.length > 0 && (
    <div class="meta-tags">
      {entry.data.tags.slice(0, 4).map((tag) => (
        <span class="tag-pill">{tag}</span>
      ))}
    </div>
  )}
</div>