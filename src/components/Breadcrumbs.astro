---
interface Crumb {
  text: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <nav class="breadcrumbs" aria-label="Briciole di pane">
    <ol>
      {items.map((item, index) => (
        <li>
          {item.href ? (
            <a href={item.href}>{item.text}</a>
          ) : (
            <span aria-current="page">{item.text}</span>
          )}
          {index < items.length - 1 && <span class="separator">/</span>}
        </li>
      ))}
    </ol>
  </nav>
)}