---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const hubs = (await getCollection('hubs')).sort(
  (a, b) => a.data.order - b.data.order
);

const breadcrumbs = [
  { text: 'Home', href: '/' },
  { text: 'Hub' },
];
---

<BaseLayout
  title="Hub editoriali | DiveBuddy"
  description="Le aree tematiche di DiveBuddy: iniziare, migliorare, viaggiare, insegnare e costruire community."
  breadcrumbs={breadcrumbs}
>
  <section class="container page-header">
    <h1>Hub editoriali</h1>
    <p class="lead">
      I grandi percorsi tematici di DiveBuddy.
    </p>
  </section>

  <section class="container section">
    <div class="grid">
      {hubs.map((hub) => (
        <Card
          title={hub.data.title}
          description={hub.data.description}
          href={`/hub/${hub.data.slug}/`}
        />
      ))}
    </div>
  </section>
</BaseLayout>